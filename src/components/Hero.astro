---
// Герой v2 (art/v2/SPEC.md): ростомер 3–7 — навигация по возрасту, барс растёт при прокрутке.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site.config';
import T from './T.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { t } from '../i18n';
import c3 from '../assets/cub/bars-3.webp';
import c5 from '../assets/cub/bars-5.webp';
import c6 from '../assets/cub/bars-6.webp';
import c7 from '../assets/cub/bars-7.webp';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });
const photoSrc = site.hero.photo ? Object.entries(files).find(([k]) => k.endsWith('/images/' + site.hero.photo))?.[1].default : undefined;
const photo = photoSrc ? await getImage({ src: photoSrc, width: 860, height: 640, fit: 'cover', format: 'webp', quality: 74 }) : undefined;
const r = site.rating;
const value = r ? r.value.toFixed(1).replace('.', ',') : '';
// засечка → группа фильтра, поза, цвет (DECISIONS.md)
const ticks = [
  { age: 3, bucket: '3-5', c: 'pink' }, { age: 4, bucket: '3-5', c: 'yellow' }, { age: 5, bucket: '5-7', c: 'mint' },
  { age: 6, bucket: '5-7', c: 'blue' }, { age: 7, bucket: '5-7', c: 'pink' },
];
const cubs = [{ p: 3, src: c3 }, { p: 5, src: c5 }, { p: 6, src: c6 }, { p: 7, src: c7 }];
---
<section class="hero2" aria-labelledby="h1" data-hero data-age="3">
  <svg class="doodles" aria-hidden="true" viewBox="0 0 390 300" preserveAspectRatio="xMaxYMin meet" filter="url(#pencil)">
    <g transform="translate(350 40)"><circle r="11" fill="var(--yellow)" class="doo" stroke="var(--yellow-d)"/><path class="doo" stroke="var(--yellow-d)" d="M0-18v-6M0 18v6M-18 0h-6M18 0h6M-13-13l-4-4M13 13l4 4M13-13l4-4M-13 13l-4 4"/></g>
  </svg>
  <div class="wrap hero2-in">
    <div class="hero2-text">
      <T as="h1" id="h1" k="hero.h1" class="kicker" />
      <p class="display"><T k="hero.sloganA" /> <em class="hl"><T k="hero.sloganHl" /></em><br class="br-d" /> <T k="hero.sloganB" /></p>
      {r && (
        <a class="rating2" href="#otzyvy" aria-label={t('rating.aria', { value, count: r.count })} data-i18n-attr="aria-label=rating.aria" data-i18n-vars={JSON.stringify({ value, count: r.count })}>
          <span class="star" data-hop aria-hidden="true">★</span><b>{value}</b> <T k="rating.label" vars={{ count: r.count }} class="m" />
        </a>
      )}
      <p class="pick m-only"><T k="hero.pick" /> ↓</p>
      <div class="hero2-cta d-only">
        <WhatsAppButton place="hero" ariaKey="cta.trialAria" class="btn-big" />
        <a class="link" href="#programmy"><T k="hero.pickLink" /> ↓</a>
      </div>
    </div>
    {photo && (
      <figure class="frame hframe d-only">
        <span class="tape" style="background:var(--yellow)"></span>
        <img src={photo.src} alt={t(site.hero.photoCapKey as any)} data-i18n-attr={`alt=${site.hero.photoCapKey}`} width="430" height="320" decoding="async" />
        <T as="figcaption" k={site.hero.photoCapKey as any} class="cap" />
      </figure>
    )}

    <div class="ruler" data-ruler>
      <svg class="ruler-v" aria-hidden="true" width="100" height="400" viewBox="0 0 100 400" filter="url(#pencil)">
        <path class="pen" d="M52 388 C51 340 54 300 52 260 S50 180 53 130 S51 100 52 82 C53 70 50 60 54 50"/>
        <path class="doo" stroke="var(--pink-d)" stroke-width="4" d="M46 360H74"/><path class="doo" stroke="var(--yellow-d)" stroke-width="4" d="M46 288H74"/>
        <path class="doo" stroke="var(--mint-d)" stroke-width="4" d="M46 216H74"/><path class="doo" stroke="var(--blue-d)" stroke-width="4" d="M46 144H74"/>
        <path class="doo" stroke="var(--pink-d)" stroke-width="4" d="M46 72H74"/>
        <path class="pen" style="opacity:.4" d="M47 324h10M47 252h10M47 180h10M47 108h10"/>
        <path fill="var(--mint)" stroke="var(--mint-d)" stroke-width="1.6" d="M53 60 C40 44 26 42 14 46 C22 60 38 66 53 60Z"/>
        <path fill="var(--mint)" stroke="var(--mint-d)" stroke-width="1.6" d="M54 52 C62 30 78 20 94 18 C90 36 74 50 54 52Z"/>
      </svg>
      <svg class="ruler-h" aria-hidden="true" viewBox="0 0 1000 80" preserveAspectRatio="none" filter="url(#pencil)">
        <path class="pen" vector-effect="non-scaling-stroke" d="M20 60 C200 58 300 62 450 60 S700 57 820 61 S900 59 940 58"/>
        <path class="doo" vector-effect="non-scaling-stroke" stroke="var(--pink-d)" stroke-width="4" d="M50 46V74"/><path class="doo" vector-effect="non-scaling-stroke" stroke="var(--yellow-d)" stroke-width="4" d="M250 46V74"/>
        <path class="doo" vector-effect="non-scaling-stroke" stroke="var(--mint-d)" stroke-width="4" d="M450 46V74"/><path class="doo" vector-effect="non-scaling-stroke" stroke="var(--blue-d)" stroke-width="4" d="M650 46V74"/>
        <path class="doo" vector-effect="non-scaling-stroke" stroke="var(--pink-d)" stroke-width="4" d="M850 46V74"/>
        <path class="pen" vector-effect="non-scaling-stroke" style="opacity:.4" d="M150 54v12M350 54v12M550 54v12M750 54v12"/>
      </svg>
      <svg class="sprout-h" aria-hidden="true" width="100" height="80" viewBox="0 0 100 80" filter="url(#pencil)"><path class="pen" d="M40 78 C44 60 42 44 46 28"/><path fill="var(--mint)" stroke="var(--mint-d)" stroke-width="1.8" d="M45 46 C32 30 18 28 6 32 C14 46 30 52 45 46Z"/><path fill="var(--mint)" stroke="var(--mint-d)" stroke-width="1.8" d="M46 34 C54 12 70 2 90 0 C86 18 68 32 46 34Z"/></svg>
      <svg class="numdot" aria-hidden="true" width="40" height="40" filter="url(#crayon)"><circle cx="20" cy="20" r="16"/></svg>
      {ticks.map((k, i) => (
        <a class="num" href="#programmy" style={`--i:${i}`} data-bucket-link={k.bucket} data-goal="age_pick" data-place={`tick-${k.age}`}
          aria-label={t('hero.tickAria', { age: k.age })} data-i18n-attr="aria-label=hero.tickAria" data-i18n-vars={JSON.stringify({ age: k.age })}>{k.age}</a>
      ))}
      <a class="acard acard-35" href="#programmy" data-bucket-link="3-5" data-goal="age_pick" data-place="card-3-5">
        <svg aria-hidden="true" viewBox="0 0 188 134" preserveAspectRatio="none" filter="url(#crayon)"><path fill="var(--pink)" d="M8 10 Q94 0 180 8 Q188 66 182 126 Q94 134 6 128 Q0 68 8 10Z"/></svg>
        <T k="hero.c35" class="l" /><span class="p"><T k="hero.c35p" /> <b aria-hidden="true">→</b></span>
      </a>
      <a class="acard acard-57" href="#programmy" data-bucket-link="5-7" data-goal="age_pick" data-place="card-5-7">
        <svg aria-hidden="true" viewBox="0 0 188 212" preserveAspectRatio="none" filter="url(#crayon)"><path fill="var(--mint)" d="M6 8 Q94 2 182 10 Q188 106 182 204 Q94 210 8 204 Q2 106 6 8Z"/></svg>
        <T k="hero.c57" class="l" /><span class="p"><T k="hero.c57p" /> <b aria-hidden="true">→</b></span>
      </a>
      <span class="floor" aria-hidden="true"></span>
      <div class="cubs" aria-hidden="true">
        {cubs.map((c) => <img class={`p${c.p}`} src={c.src.src} width={c.src.width} height={c.src.height} alt="" loading="eager" decoding="async" />)}
      </div>
      <svg class="hand" aria-hidden="true" width="40" height="44" viewBox="-20 -30 40 50" filter="url(#pencil)"><path class="doo" stroke="var(--pink-d)" fill="var(--pink)" d="M-12 14c-6-6-6-16 0-22l2-18c0-4 6-4 6 0l1 12 1-18c0-4 6-4 6 0l0 18 2-15c0-4 6-4 6 0l-1 17 4-10c2-4 7-2 6 2l-5 18c-2 8-8 14-16 14-5 0-9-2-12-4z"/></svg>
    </div>
  </div>
</section>
