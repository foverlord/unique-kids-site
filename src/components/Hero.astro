---
// Герой v3 (art/v3/SPEC.md §2–4): горизонтальный ростомер 3–7 + ветка «Школа 7+».
// Координаты — из прототипов Арта (page-mobile.html 390, page-desktop.html 1440); сцена масштабируется по ширине (cqw).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site.config';
import T from './T.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { t } from '../i18n';
import c3 from '../assets/cub/bars-3.webp';
import c5 from '../assets/cub/bars-5.webp';
import c6 from '../assets/cub/bars-6.webp';
import c7 from '../assets/cub/bars-7.webp';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });
// v4: три фото без подписей (art/v4/SPEC.md §1)
const photos = await Promise.all((site.hero.photos ?? []).map(async (ph) => {
  const src = Object.entries(files).find(([k]) => k.endsWith('/images/' + ph.file))?.[1].default;
  return src ? { ...ph, img: await getImage({ src, width: 440, height: 560, fit: 'cover', format: 'webp', quality: 72 }) } : undefined;
})).then((a) => a.filter((x) => !!x));
const tapes = ['pink', 'mint', 'yellow'];
const r = site.rating;
const value = r ? r.value.toFixed(1).replace('.', ',') : '';
const cubs = [{ p: 3, src: c3 }, { p: 5, src: c5 }, { p: 6, src: c6 }, { p: 7, src: c7 }];
const colors = ['pink', 'yellow', 'mint', 'blue', 'pink'];

type V = { id: 'm' | 'd'; W: number; X0: number; Y0: number; H: number; tx: number[]; line: number; num: number; numF: number; dot: number;
  cubW: number; cubH: number; school: [number, number]; bands: [string, number, number][]; bandY: number; bandH: number; bandF: number;
  chip: [number, number]; chipF: number; house: [number, number, number]; paths: { line: string; shelf: string; leaves: string[] }; walkY: number; walkSchool: string };
const variants: V[] = [
  { id: 'm', W: 390, X0: 0, Y0: 528, H: 292, tx: [44, 98, 152, 206, 260], line: 730, num: 764, numF: 20, dot: 19, cubW: 84, cubH: 110, school: [342, 646],
    bands: [['3-5', 26, 120], ['5-7', 132, 278], ['7plus', 280, 388]], bandY: 780, bandH: 32, bandF: 12.5, chip: [218, 640], chipF: 12, house: [250, 598, 1],
    paths: { line: 'M18 730 C90 728 170 732 240 730 S282 729 288 726 C297 722 300 712 300 700 C301 660 299 610 300 575 C300 568 300 564 301 560',
      shelf: 'M300 650 C326 646 352 648 382 644',
      leaves: ['M382 644 C374 632 362 630 352 635 C358 646 370 650 382 644Z', 'M300 572 C288 558 274 556 264 561 C272 574 288 578 300 572Z', 'M301 562 C309 542 324 533 340 531 C335 548 320 560 301 562Z'] },
    walkY: 722, walkSchool: 'M44 722 L288 722 C296 720 296 706 296 690 L296 662 C300 655 320 655 342 655' },
  { id: 'd', W: 1200, X0: 120, Y0: 410, H: 366, tx: [200, 400, 600, 800, 1000], line: 670, num: 703, numF: 26, dot: 23, cubW: 160, cubH: 200, school: [1200, 596],
    bands: [['3-5', 160, 440], ['5-7', 560, 1040], ['7plus', 1080, 1300]], bandY: 732, bandH: 40, bandF: 15, chip: [1150, 607], chipF: 14, house: [1108, 610, 1.1], // 16.11: под полкой школы, барс на «7» её больше не закрывает
    paths: { line: 'M150 670 C300 668 420 673 560 670 S800 667 940 671 S1060 669 1086 668 C1100 667 1104 656 1104 640 C1105 590 1103 520 1104 470 C1105 456 1103 446 1106 436',
      shelf: 'M1104 600 C1150 594 1220 598 1300 590',
      leaves: ['M1300 590 C1290 574 1274 572 1262 578 C1270 592 1286 596 1300 590Z', 'M1104 452 C1088 434 1070 432 1056 438 C1066 454 1086 460 1104 452Z', 'M1106 440 C1116 414 1136 402 1156 400 C1150 422 1130 438 1106 440Z'] },
    walkY: 656, walkSchool: 'M200 656 L1086 656 C1098 654 1098 630 1098 610' },
];
// позиции барса по состояниям: [x центра, верх]
// состояние → [сдвиг барса x, y, x кружка под цифрой, поза, цвет] в единицах макета от начала сцены
const pose = [3, 3, 5, 6, 7];
// 16.11 (Кэп/Арт): цифры — белые кнопки прямо на линии, барс стоит над кнопкой
const LIFT = 26;
const pos = (v: V) => Object.fromEntries([
  ...v.tx.map((x, i) => [String(3 + i), [x - v.X0 - v.cubW / 2, v.line - v.cubH - v.Y0 - LIFT, x - v.X0 - v.dot - 4, pose[i], colors[i]]]),
  ['school', [v.school[0] - v.X0 - v.cubW / 2, v.school[1] - v.cubH - v.Y0, -999, 7, 'blue']],
]);
const u = (n: number) => `calc(var(--u) * ${n})`;
---
<section class="hero3" aria-labelledby="h1" data-hero data-age="3">
  <svg class="h3-sun" aria-hidden="true" width="56" height="56" viewBox="-28 -28 56 56" filter="url(#pencil)"><circle r="11" fill="var(--yellow)" class="doo" stroke="var(--yellow-d)"/><path class="doo" stroke="var(--yellow-d)" d="M0-18v-6M0 18v6M-18 0h-6M18 0h6M-13-13l-4-4M13 13l4 4M13-13l4-4M-13 13l-4 4"/></svg>
  <div class="wrap">
    <div class="h3-grid">
      <div class="h3-text">
        <T as="h1" id="h1" k="hero.h1" class="kicker" />
        <p class="display"><T k="hero.sloganA" /> <em class="hl"><T k="hero.sloganHl" /></em><br /> <T k="hero.sloganB" /></p>
        {r && (
          <a class="rating2" href="#otzyvy" aria-label={t('rating.aria', { value, count: r.count })} data-i18n-attr="aria-label=rating.aria" data-i18n-vars={JSON.stringify({ value, count: r.count })}>
            <span class="star" data-hop aria-hidden="true">★</span><b>{value}</b> <T k="rating.label" vars={{ count: r.count }} class="m" />
          </a>
        )}
      </div>
      {photos.length > 0 && (
        <div class="h3-trio">
          {photos.map((ph, i) => (
            <figure class:list={['frame', `f${i + 1}`]}>
              <span class="tape" style={`background:var(--${tapes[i % 3]})`}></span>
              <img src={ph.img.src} alt={t(ph.altKey as any)} data-i18n-attr={`alt=${ph.altKey}`} width="220" height="280" style={`object-position:${ph.pos}`} fetchpriority={i === 1 ? 'high' : 'auto'} decoding="async" />
            </figure>
          ))}
        </div>
      )}
      <div class="h3-cta" id="cta"><WhatsAppButton place="hero" ariaKey="cta.trialAria" class="btn-big btn-wa3" /></div>
      <T as="p" k={'hero.askTap' as any} class="h3-ask" />
    </div>
    <div class="age6" role="group" aria-labelledby="a6-ask">
      <div class="a6-cub" aria-hidden="true" data-pose="3">
        {cubs.map((c) => <img class:list={[`p${c.p}`, { on: c.p === 3 }]} src={c.src.src} width={c.src.width} height={c.src.height} alt="" loading="eager" decoding="async" />)}
      </div>
      <T as="p" id="a6-ask" k="hero.ask" class="a6-ask" />
      <div class="a6-grid">
        {[3, 4, 5, 6, 7].map((n) => (
          <button type="button" class="a6-btn" data-set-age={n} data-c={n < 5 ? 'pink' : 'mint'} aria-pressed="false"><T k={n < 5 ? 'age.y34' : 'age.y'} vars={{ n }} /></button>
        ))}
        <button type="button" class="a6-btn" data-set-age="school" data-c="blue" aria-pressed="false"><T k="hero.school" /></button>
      </div>
    </div>
    {variants.map((v) => (
      <div class:list={['stage', v.id === 'm' ? 'st-m' : 'st-d']} style={`--W:${v.W};aspect-ratio:${v.W}/${v.H}`} data-stage data-pos={JSON.stringify(pos(v))}
        data-walk={JSON.stringify({ y: v.walkY, tx: v.tx, school: v.walkSchool })}>
        <svg class="st-svg" viewBox={`${v.X0} ${v.Y0} ${v.W} ${v.H}`} aria-hidden="true" filter="url(#pencil)">
          <path class="doo walk" stroke="var(--pink-d)" stroke-dasharray="2 8" stroke-width="3" d={`M${v.tx[0]} ${v.walkY} L${v.tx[0]} ${v.walkY}`} />
          <path class="pen" d={v.paths.line} />
          <path class="pen" d={v.paths.shelf} />
          {v.paths.leaves.map((d) => <path fill="var(--mint)" stroke="var(--mint-d)" stroke-width="1.8" d={d} />)}
          {v.tx.map((x, i) => <path class="doo" stroke={`var(--${colors[i]}-d)`} stroke-width="4" d={`M${x} ${v.line - 14}v28`} />)}
          <g transform={`translate(${v.house[0]} ${v.house[1]}) scale(${v.house[2]})`}><path d="M0 14 L16 2 L32 14Z" fill="var(--blue)" stroke="var(--blue-d)" stroke-width="1.6" /><path class="doo" stroke="var(--blue-d)" d="M4 13v17h24V13M13 30v-8h6v8M16 2v-8l6 2-6 2"/></g>
        </svg>
        <svg class="st-dot" aria-hidden="true" viewBox="0 0 46 46" filter="url(#crayon)" style={`width:${u(v.dot * 2 + 8)};height:${u(v.dot * 2 + 8)};top:${u(v.num - v.Y0 - v.dot - 4)};--dx:${v.tx[0] - v.X0 - v.dot - 4}`}><circle cx="23" cy="23" r="19" /></svg>
        {v.tx.map((x, i) => (
          <button type="button" class="st-num" data-set-age={3 + i} style={`left:${u(x - v.X0 - 30)};top:${u(v.line - v.Y0 - 24)};font-size:${u(v.numF)};--bc:var(--${colors[i]})`} aria-pressed="false"
            aria-label={t('hero.tickAria', { age: 3 + i })} data-i18n-attr="aria-label=hero.tickAria" data-i18n-vars={JSON.stringify({ age: 3 + i })}>{3 + i}</button>
        ))}
        <button type="button" class="st-chip" data-set-age="school" style={`left:${u(v.chip[0] - v.X0)};top:${u(v.chip[1] - v.Y0)};font-size:${u(v.chipF)}`}><T k="hero.school" /></button>
        <div class="st-cubs" aria-hidden="true" style={`width:${u(v.cubW)};height:${u(v.cubH)};--cx:${v.tx[0] - v.X0 - v.cubW / 2};--cy:${v.line - v.cubH - v.Y0 - LIFT}`}>
          {cubs.map((c) => <img class={`p${c.p}`} src={c.src.src} width={c.src.width} height={c.src.height} alt="" loading="eager" decoding="async" />)}
        </div>
      </div>
    ))}
  </div>
</section>
