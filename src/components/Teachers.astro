---
import { site } from '../config/site.config';
import T from './T.astro';
import TeacherCard from './TeacherCard.astro';
const list = site.teachers;
---
{list.length > 0 && (
  <section class="sec" id="pedagogi" aria-labelledby="tch-h">
    <div class="wrap">
      <T as="h2" id="tch-h" k="teachers.title" />
      <T as="p" k="teachers.sub" class="lead" />
      <div class:list={['grid3', { 'grid-one': list.length === 1 }]}>{list.map((tch) => <TeacherCard tch={tch} />)}</div>
    </div>
  </section>
)}
