---
import { site } from '../config/site.config';
import T from './T.astro';
const list = site.teachers;
---
{list.length > 0 && (
  <section class="v3 sec3" id="apai" aria-labelledby="tch-h">
    <svg class="doodle" style="--doo-r:8px;top:18px;transform:rotate(12deg)" aria-hidden="true" width="44" height="50" viewBox="-22 -28 44 50" filter="url(#pencil)"><path class="doo" stroke="var(--pink-d)" fill="var(--pink)" d="M-12 14c-6-6-6-16 0-22l2-18c0-4 6-4 6 0l1 12 1-18c0-4 6-4 6 0l0 18 2-15c0-4 6-4 6 0l-1 17 4-10c2-4 7-2 6 2l-5 18c-2 8-8 14-16 14-5 0-9-2-12-4z"/></svg>
    <div class="wrap">
      <T as="h2" id="tch-h" k="teachers.title" />
      <T as="p" k="teachers.sub" class="sub" />
      <div class="apai3 rot">
        {list.map((tch, i) => (
          <article class="teacher3 patch patch--long">
            <svg class="pbg" aria-hidden="true" filter="url(#crayon)"><rect x="6" y="6" rx="10" style="width:calc(100% - 12px);height:calc(100% - 12px)" /></svg>
            <i class:list={['tape', { r: i % 2 }]}></i>
            <div class="mono" aria-hidden="true">{tch.name.trim().charAt(0)}</div>
            <h3>{tch.name}</h3>
            {tch.roleKey ? <T k={tch.roleKey as any} class="role" /> : <span></span>}
            <blockquote lang={tch.lang}>«<T k={tch.bioKey as any} />»</blockquote>
            {tch.by && <T k="teachers.by" vars={{ v: tch.by }} class="by" />}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
