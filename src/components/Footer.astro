---
import { waUrl } from '../scripts/wa';
import { site } from '../config/site.config';
import T from './T.astro';
---
<footer class="v3 ftr3">
  <svg class="wave" aria-hidden="true" viewBox="0 0 1440 40" preserveAspectRatio="none" filter="url(#crayon)"><path d="M0 22 C120 6 240 6 360 20 S600 36 720 20 S960 4 1080 18 S1320 34 1440 18 L1440 40 L0 40Z" fill="#EAF4EE"/></svg>
  <div class="wrap">
    <img src="/logo.svg" alt={site.name} width="209" height="46" class="ftr-logo" loading="lazy" />
    <div class="cols">
      <div><b><T k="facts.addr" /></b><br />Есиль, Астана</div>
      <div><T k="footer.hours" /><br /><T k="footer.off" /></div>
      <div><a href={`tel:${site.phoneE164}`} data-goal="tel_click" class="tel">{site.phoneDisplay}</a><br /><a class="walink" href={waUrl('ru')} data-wa target="_blank" rel="noopener" data-goal="wa_click" data-place="footer"><T k="footer.wa" /></a></div>
    </div>
    <p class="small"><T k="footer.tag" /> · <a href={site.mapUrl} target="_blank" rel="noopener"><T k="footer.card" /></a> · <a href="/politika"><T k="footer.policy" /></a>{site.demoNote && <> · <T k="footer.demo" /></>}</p>
  </div>
</footer>
