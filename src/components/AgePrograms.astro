---
import { site } from '../config/site.config';
import T from './T.astro';
import ProgramCard from './ProgramCard.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { t } from '../i18n';
// art/v3: программа в группе, если её возраст пересекает диапазон группы
const inBucket = (p: { ageFrom: number; ageTo: number }, b: { ageFrom: number; ageTo: number }) => p.ageFrom <= b.ageTo && p.ageTo >= b.ageFrom;
const buckets = site.ageBuckets.map((b) => ({ ...b, ids: b.id === 'all' ? '*' : site.programs.filter((p) => inBucket(p, b)).map((p) => p.id).join(',') }));
const order = ['all', '3-5', '5-7', '7plus']; // Кэп 16.11: «Все» первой и выбрана по умолчанию
buckets.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const def = site.defaultAgeBucket ?? 'all';
---
{site.programs.length > 0 && (
  <section class="v3 sec3" id="programmy" aria-labelledby="prog-h">
    <svg class="doodle" style="--doo-r:14px;top:24px" aria-hidden="true" width="30" height="30" viewBox="-14 -2 28 28" filter="url(#pencil)"><path class="doo" stroke="var(--pink-d)" fill="var(--pink)" d="M0 0l3 7 8 1-6 5 2 8-7-4-7 4 2-8-6-5 8-1z"/></svg>
    <div class="wrap">
      <T as="h2" id="prog-h" k="programs.title" />
      <T as="p" k="programs.lead" class="sub" />
      {buckets.length > 1 && (
        <T as="p" k="programs.showFor" class="tabs3-l" />
        <div class="tabs3" role="group" aria-label={t('programs.agesLabel')} data-i18n-attr="aria-label=programs.agesLabel">
          {buckets.map((b) => (
            <button type="button" class="tab3" data-bucket={b.id} data-ids={b.ids} aria-pressed={b.id === def ? 'true' : 'false'}><T k={b.labelKey as any} /></button>
          ))}
        </div>
      )}
      <div class="progs rot" data-prog-grid>
        {site.programs.map((p, i) => <ProgramCard p={p} i={i} />)}
      </div>
      <div class="prog-empty" data-prog-empty hidden>
        <T as="p" k="programs.empty" />
        <WhatsAppButton place="empty" />
      </div>
    </div>
  </section>
)}
