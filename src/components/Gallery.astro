---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site.config';
import T from './T.astro';
import Icon from './Icon.astro';
import { t } from '../i18n';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const byName = (n: string) => Object.entries(files).find(([k]) => k.endsWith('/' + n))?.[1].default;
const items = await Promise.all(site.gallery.map(async (g) => {
  const src = byName(g.src);
  if (!src) throw new Error(`gallery: нет файла ${g.src}`);
  const [thumb, full] = await Promise.all([
    getImage({ src, width: 600, height: 450, fit: 'cover', format: 'webp', quality: 72 }),
    getImage({ src, width: 1600, format: 'webp', quality: 78 }),
  ]);
  return { ...g, thumb: thumb.src, full: full.src };
}));
---
{items.length > 0 && (
  <section class="sec" id="galereya" aria-labelledby="gal-h">
    <div class="wrap">
      <T as="h2" id="gal-h" k="gallery.title" />
      <ul class="gallery">
        {items.map((g, i) => (
          <li><button type="button" class="gal-item" data-gal={i} data-full={g.full}>
            <img src={g.thumb} alt={t(g.altKey)} data-i18n-attr={`alt=${g.altKey}`} loading="lazy" decoding="async" width="600" height="450" />
          </button></li>
        ))}
      </ul>
    </div>
    <dialog class="lightbox" data-lightbox>
      <img data-lb-img alt="" />
      <button type="button" class="icon-btn lb-close" data-lb-close aria-label={t('gallery.close')} data-i18n-attr="aria-label=gallery.close"><Icon name="close" /></button>
      <button type="button" class="icon-btn lb-prev" data-lb="-1" aria-label={t('gallery.prev')} data-i18n-attr="aria-label=gallery.prev"><Icon name="arrow-l" /></button>
      <button type="button" class="icon-btn lb-next" data-lb="1" aria-label={t('gallery.next')} data-i18n-attr="aria-label=gallery.next"><Icon name="arrow-r" /></button>
    </dialog>
  </section>
)}
