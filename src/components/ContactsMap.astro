---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site.config';
import T from './T.astro';
import { t } from '../i18n';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });
const src = site.find ? Object.entries(files).find(([k]) => k.endsWith('/images/' + site.find!.photo))?.[1].default : undefined;
const img = src ? await getImage({ src, width: 720, height: 680, fit: 'cover', format: 'webp', quality: 72 }) : undefined;
const mapSrc = site.find?.map ? Object.entries(files).find(([k]) => k.endsWith('/images/' + site.find!.map))?.[1].default : undefined;
const map = mapSrc ? await getImage({ src: mapSrc, width: 1000, format: 'webp', quality: 74 }) : undefined;
---
<section class="v3 sec3" id="kontakty" aria-labelledby="ct-h">
  <svg class="doodle" style="--doo-r:4px;top:16px" aria-hidden="true" width="66" height="40" viewBox="-8 -12 66 40" filter="url(#pencil)"><path class="doo" stroke="var(--blue-d)" fill="#E6F1FB" d="M0 20c-10 0-14-12-4-16 0-12 16-14 20-5 6-8 20-4 19 6 10 1 10 15 0 15z"/></svg>
  <div class="wrap">
    <T as="h2" id="ct-h" k="find.title" />
    <div class="findgrid">
      {img && site.find && (
        <figure class="frame find-photo"><span class="tape" style="background:var(--mint)"></span>
          <img src={img.src} width="360" height="340" loading="lazy" style="object-position:center 32%" decoding="async" alt={t(site.find.capKey as any)} data-i18n-attr={`alt=${site.find.capKey}`} />
          <T as="figcaption" k={site.find.capKey as any} class="cap" />
        </figure>
      )}
      <div>
        {map && (
          <figure class="find-map">
            <img src={map.src} width={map.attributes.width ?? 1000} height={map.attributes.height ?? 661} loading="lazy" decoding="async" alt={t('find.mapAlt' as any)} data-i18n-attr="alt=find.mapAlt" />
            <T as="figcaption" k={'find.osm' as any} class="attr" />
          </figure>
        )}
        <T as="p" k="facts.addr" class="addr" />
        <T as="p" k={'find.hours' as any} class="muted" />
        <a class="phone" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
        <div class="find-btns">
          <a class="btn-line" href={site.mapUrl} target="_blank" rel="noopener"><T k="find.open" /></a>
          {site.find?.routeUrl && <a class="btn-line" href={site.find.routeUrl} target="_blank" rel="noopener"><T k={'find.route' as any} /></a>}
        </div>
      </div>
    </div>
  </div>
</section>
