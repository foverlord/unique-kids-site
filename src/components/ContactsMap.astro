---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site.config';
import T from './T.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { t } from '../i18n';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/**/*.{jpg,jpeg,png,webp}', { eager: true });
const src = site.find ? Object.entries(files).find(([k]) => k.endsWith('/images/' + site.find!.photo))?.[1].default : undefined;
const img = src ? await getImage({ src, width: 720, height: 720, fit: 'cover', format: 'webp', quality: 72 }) : undefined;
---
<section class="v3 sec3" id="kontakty" aria-labelledby="ct-h">
  <svg class="doodle" style="right:4px;top:16px" aria-hidden="true" width="66" height="40" viewBox="-8 -12 66 40" filter="url(#pencil)"><path class="doo" stroke="var(--blue-d)" fill="#E6F1FB" d="M0 20c-10 0-14-12-4-16 0-12 16-14 20-5 6-8 20-4 19 6 10 1 10 15 0 15z"/></svg>
  <div class="wrap">
    <T as="h2" id="ct-h" k="find.title" />
    <div class="findgrid">
      {img && site.find && (
        <figure class="frame find-photo"><span class="tape" style="background:var(--mint)"></span>
          <img src={img.src} width="360" height="360" loading="lazy" decoding="async" alt={t(site.find.capKey as any)} data-i18n-attr={`alt=${site.find.capKey}`} />
          <T as="figcaption" k={site.find.capKey as any} class="cap" />
        </figure>
      )}
      <div>
        <a href={site.mapUrl} target="_blank" rel="noopener" aria-label={`${t('facts.addr')} — 2ГИС`}>
          <svg class="map" aria-hidden="true" viewBox="0 0 342 220" filter="url(#pencil)">
            <rect x="40" y="26" width="220" height="110" rx="4" fill="#FFFFFF" stroke="#2B2620" stroke-width="2" />
            <text x="150" y="70" text-anchor="middle" font-family="Nunito" font-weight="800" font-size="18" fill="#2B2620">58а к1</text>
            <path d="M118 136 L118 120 L182 120 L182 136" fill="var(--mint)" stroke="#2B2620" stroke-width="2" />
            <text x="150" y="132" text-anchor="middle" font-family="Nunito" font-weight="900" font-size="10" fill="#2B2620">Unique kids</text>
            <path d="M150 140 C150 160 154 170 150 186" fill="none" stroke="var(--pink-d)" stroke-width="2.6" stroke-dasharray="2 6" stroke-linecap="round" />
            <path d="M196 136 L230 136 L230 128 Z" fill="var(--yellow)" stroke="#2B2620" stroke-width="1.6" /><text x="236" y="134" font-family="Golos Text" font-size="11" fill="#6B6358">пандус</text>
            <path d="M10 188 C120 184 230 192 332 186 L332 214 C230 218 120 210 10 214Z" fill="#EDE4D3" stroke="#2B2620" stroke-width="2" />
            <text x="171" y="205" text-anchor="middle" font-family="Golos Text" font-weight="600" font-size="12" fill="#2B2620">пр. Кабанбай батыра</text>
            <g transform="translate(286 70)"><path d="M0 22 C-14 4 -12 -12 0 -12 C12 -12 14 4 0 22Z" fill="var(--pink)" stroke="#2B2620" stroke-width="2" /><circle cy="-2" r="4" fill="#FBF6EC" stroke="#2B2620" stroke-width="1.6" /></g>
          </svg>
        </a>
        <T as="p" k="facts.addr" class="addr" />
        <T as="p" k="find.meta" class="muted" />
        <div class="find-btns">
          <a class="btn-line" href={site.mapUrl} target="_blank" rel="noopener"><T k="find.open" /></a>
          <WhatsAppButton place="contacts" labelKey="cta.whatsapp" class="btn-wa3 sm" />
        </div>
      </div>
    </div>
  </div>
</section>
