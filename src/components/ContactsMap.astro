---
import { site } from '../config/site.config';
import T from './T.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---
<section class="sec sec-alt" id="kontakty" aria-labelledby="ct-h">
  <div class="wrap contacts">
    <div>
      <T as="h2" id="ct-h" k="contacts.title" />
      <dl class="ct-list">
        <div><dt><Icon name="pin" /><T k="contacts.address" /></dt><dd>{site.address}{site.addressNote && <>, {site.addressNote}</>}, {site.city}</dd></div>
        {site.hoursKey && <div><dt><Icon name="clock" /><T k="contacts.hours" /></dt><dd><T k={site.hoursKey as any} /></dd></div>}
        <div><dt><Icon name="phone" /><T k="contacts.phone" /></dt><dd><a href={`tel:${site.phoneE164}`} data-goal="tel_click">{site.phoneDisplay}</a></dd></div>
        {site.instagram && <div><dt><Icon name="insta" />Instagram</dt><dd><a href={site.instagram} target="_blank" rel="noopener">@{site.instagram.split('/').filter(Boolean).pop()}</a></dd></div>}
      </dl>
      <div class="hero-cta">
        <WhatsAppButton place="contacts" labelKey="cta.whatsapp" />
        <a class="btn btn-secondary" href={site.mapUrl} target="_blank" rel="noopener"><Icon name="map" size={20} /><T k="contacts.open2gis" /></a>
      </div>
    </div>
    <a class="map-card" href={site.mapUrl} target="_blank" rel="noopener" aria-label={`${site.address} — 2ГИС`}>
      <!-- Плейсхолдер схемы: Арт заменит нарисованной картой -->
      <svg viewBox="0 0 400 300" aria-hidden="true"><g fill="none" stroke="var(--color-line)" stroke-width="10" stroke-linecap="round"><path d="M-10 90 L410 120"/><path d="M120 -10 L150 310"/><path d="M-10 240 L410 210"/><path d="M290 -10 L270 310"/></g><g fill="none" stroke="var(--color-ink)" stroke-width="2.5" stroke-linecap="round"><path d="M200 140 c0 -24 -36 -24 -36 0 c0 20 18 40 18 40 s18 -20 18 -40z"/></g><circle cx="182" cy="140" r="6" fill="var(--color-accent)"/></svg>
      <span class="map-label"><T k="contacts.route" /></span>
    </a>
  </div>
</section>
