---
import { t } from '../i18n';
---
<div class="locale" role="group" aria-label={t('locale.label')} data-i18n-attr="aria-label=locale.label">
  <button type="button" data-locale="ru" aria-pressed="true" lang="ru">RU</button>
  <button type="button" data-locale="kk" aria-pressed="false" lang="kk" hidden>ҚАЗ</button>
</div>
